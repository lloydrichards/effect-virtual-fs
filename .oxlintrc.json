{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
    "./node_modules/@effect/tsgo/oxlint-presets/effect-native.json"
  ],
  "options": {
    "denyWarnings": true
  },
  "overrides": [
    {
      "files": [
        "apps/virtual-build/test/VirtualBuild.test.ts",
        "packages/persistence/test/Restart.test.ts",
        "packages/persistence/test/fixtures/restart.ts"
      ],
      "rules": {
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      "files": [
        "packages/core/test/Snapshot.test.ts"
      ],
      "rules": {
        "effecttsgo/prefer-schema-over-json": "off"
      }
    },
    {
      "files": [
        "apps/docs/**/*.ts",
        "apps/docs/**/*.tsx"
      ],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/global-date": "off",
        "effecttsgo/global-random": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off"
      }
    }
  ],
  "ignorePatterns": [
    "packages/core/contracts/ApiTypes.ts"
  ]
}
