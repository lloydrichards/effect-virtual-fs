{
  "name": "effect-vfs-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "clean": "turbo run clean && git clean -xdf .turbo",
    "dev": "turbo run dev",
    "docs:check": "bun run --filter @effect-vfs/docs docs:check",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint-staged": "lint-staged",
    "postprepare": "husky",
    "prepare": "effect-tsgo patch --oxlint",
    "release": "bun run build && changeset publish",
    "test": "bun run test:tooling && turbo run build --filter=@effect-vfs/core --filter=@effect-vfs/memory --filter=@effect-vfs/nfs --filter=@effect-vfs/persistence --filter=@effect-vfs/effect-preview && bun --bun run vitest run --config vitest.config.ts",
    "type-check": "tsc --noEmit --project tools/tsconfig.json && turbo run type-check",
    "validate": "bun tools/checks/validate.mjs",
    "lint:effects": "bun tools/checks/effects.mjs",
    "version-packages": "changeset version",
    "test:node": "bun run --cwd packages/node test && bun run --cwd packages/node test:consumer",
    "test:tooling": "bun tools/oxlint/test/run.mjs && bun test tools/checks/test tools/oxlint/test && bun run --cwd apps/docs test",
    "check": "bun run format:check && bun tools/checks/repository.mjs && bun tools/checks/boundaries.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/docgen": "~4.1.4",
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@oxlint/plugins": "1.92.0",
    "dprint": "^0.58.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsx": "4.23.15",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@effect/platform-node": "4.1.4",
    "@effect/platform-node-shared": "4.1.4",
    "@effect/sql-d1": "4.1.4",
    "dompurify": "3.4.17",
    "effect": "4.1.4"
  }
}
