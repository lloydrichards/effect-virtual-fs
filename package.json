{
  "name": "effect-vfs-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "clean": "turbo run clean && git clean -xdf .turbo",
    "dev": "turbo run dev",
    "docs:check": "bun run --filter @effect-vfs/docs docs:check",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "bun run lint:anti-slop-policy && oxlint",
    "lint:anti-slop-policy": "bun scripts/check-anti-slop-policy.mjs",
    "lint:fix": "oxlint --fix",
    "lint-staged": "lint-staged",
    "postprepare": "husky",
    "prepare": "effect-tsgo patch --oxlint",
    "release": "bun run build && changeset publish",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "validate": "bun run format:check && bun run build && bun scripts/check-generated-api.mjs && bun run lint && bun run lint:effects && bun run type-check && bun run test",
    "lint:effects": "bash scripts/lint-effects.sh",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@effect/docgen": "^0.5.2",
    "@effect/tsgo": "0.46.1",
    "@oxlint/plugins": "1.85.0",
    "dprint": "^0.57.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.11.4",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.117",
    "effect": "4.0.0-rc.117"
  }
}
