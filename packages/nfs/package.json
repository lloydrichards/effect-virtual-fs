{
  "name": "@effect-vfs/nfs",
  "version": "0.6.0",
  "description": "NFSv4.1 server for one live Effect VFS volume, with guarded experimental writes.",
  "homepage": "https://github.com/lloydrichards/effect-virtual-fs#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydrichards/effect-virtual-fs.git",
    "directory": "packages/nfs"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./NfsServer": {
      "types": "./dist/NfsServer.d.ts",
      "import": "./dist/NfsServer.js"
    },
    "./internal/*": null,
    "./index": null,
    "./*/index": null,
    "./package.json": "./package.json"
  },
  "files": ["dist/**", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist docs node_modules tsconfig.tsbuildinfo",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.115"
  },
  "dependencies": {
    "@effect-vfs/core": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@repo/config-typescript": "workspace:*",
    "effect": "4.0.0-rc.115",
    "vitest": "^5.0.1"
  }
}
