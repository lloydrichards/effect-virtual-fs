{
  "name": "@effect-vfs/effect-preview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/durableStorage": {
      "types": "./dist/internal/durableStorage.d.ts",
      "import": "./dist/internal/durableStorage.js"
    },
    "./internal/ownedCapture": {
      "types": "./dist/internal/ownedCapture.d.ts",
      "import": "./dist/internal/ownedCapture.js"
    },
    "./VirtualFileSystem": {
      "types": "./dist/virtual-file-system/VirtualFileSystem.d.ts",
      "import": "./dist/virtual-file-system/VirtualFileSystem.js"
    },
    "./BytePath": {
      "types": "./dist/compat/BytePath.d.ts",
      "import": "./dist/compat/BytePath.js"
    },
    "./Schema": {
      "types": "./dist/compat/Schema.d.ts",
      "import": "./dist/compat/Schema.js"
    },
    "./DateTime": {
      "types": "./dist/compat/DateTime.d.ts",
      "import": "./dist/compat/DateTime.js"
    }
  },
  "scripts": {
    "sync": "bun scripts/sync.mjs",
    "sync:check": "bun scripts/sync.mjs --check",
    "refresh": "bun scripts/refresh.mjs",
    "build": "bun run sync:check && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit && bun run test:types && bun run test:sync && bun run test:consumer",
    "test": "bun run build && bun --bun run vitest run --config ../../vitest.config.ts --project effect-preview",
    "test:types": "bun scripts/test-types.mjs",
    "test:consumer": "bun run build && node scripts/check-schema-consumer.mjs",
    "test:sync": "bun scripts/check-sync.mjs"
  },
  "peerDependencies": {
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "26.6.6",
    "effect": "4.1.5",
    "tstyche": "7.2.5",
    "typescript-js": "npm:typescript@5.9.3"
  }
}
