{
  "name": "@effect-vfs/core",
  "version": "0.6.0",
  "description": "A runtime-neutral virtual filesystem core for Effect.",
  "homepage": "https://github.com/lloydrichards/effect-virtual-fs#readme",
  "bugs": {
    "url": "https://github.com/lloydrichards/effect-virtual-fs/issues"
  },
  "keywords": [
    "effect",
    "filesystem",
    "virtual-filesystem",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project compatibility/node-next/tsconfig.json",
    "clean": "git clean -xdf .cache .turbo dist docs node_modules tsconfig.tsbuildinfo",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --project contracts/tsconfig.json"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node-shared": "4.0.0-rc.117",
    "@effect/vitest": "4.0.0-rc.117",
    "@repo/config-typescript": "workspace:*",
    "effect": "4.0.0-rc.117"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./VirtualFileSystem": {
      "types": "./dist/VirtualFileSystem.d.ts",
      "import": "./dist/VirtualFileSystem.js"
    },
    "./VfsError": {
      "types": "./dist/VfsError.d.ts",
      "import": "./dist/VfsError.js"
    },
    "./LiveVolume": {
      "types": "./dist/LiveVolume.d.ts",
      "import": "./dist/LiveVolume.js"
    },
    "./Caller": {
      "types": "./dist/Caller.d.ts",
      "import": "./dist/Caller.js"
    },
    "./FileHandle": {
      "types": "./dist/FileHandle.d.ts",
      "import": "./dist/FileHandle.js"
    },
    "./Fixture": {
      "types": "./dist/Fixture.d.ts",
      "import": "./dist/Fixture.js"
    },
    "./Metadata": {
      "types": "./dist/Metadata.d.ts",
      "import": "./dist/Metadata.js"
    },
    "./Target": {
      "types": "./dist/Target.d.ts",
      "import": "./dist/Target.js"
    },
    "./Volume": {
      "types": "./dist/Volume.d.ts",
      "import": "./dist/Volume.js"
    },
    "./Watch": {
      "types": "./dist/Watch.d.ts",
      "import": "./dist/Watch.js"
    },
    "./BytePath": {
      "types": "./dist/BytePath.d.ts",
      "import": "./dist/BytePath.js"
    },
    "./Snapshot": {
      "types": "./dist/Snapshot.d.ts",
      "import": "./dist/Snapshot.js"
    },
    "./SnapshotDelta": {
      "types": "./dist/SnapshotDelta.d.ts",
      "import": "./dist/SnapshotDelta.js"
    },
    "./Testing": {
      "types": "./dist/Testing.d.ts",
      "import": "./dist/Testing.js"
    },
    "./internal/*": null,
    "./index": null,
    "./*/index": null,
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydrichards/effect-virtual-fs.git",
    "directory": "packages/core"
  }
}
