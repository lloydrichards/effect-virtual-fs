{
  "name": "@effect-vfs/persistence",
  "version": "0.12.1",
  "description": "SQLite checkpoints and live-image storage for Effect virtual filesystems.",
  "homepage": "https://github.com/lloydrichards/effect-virtual-fs#readme",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydrichards/effect-virtual-fs.git",
    "directory": "packages/persistence"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./CheckpointStore": {
      "types": "./dist/CheckpointStore.d.ts",
      "import": "./dist/CheckpointStore.js"
    },
    "./SqliteLiveImageStore": {
      "types": "./dist/SqliteLiveImageStore.d.ts",
      "import": "./dist/SqliteLiveImageStore.js"
    },
    "./R2LiveImageStore": {
      "types": "./dist/R2LiveImageStore.d.ts",
      "import": "./dist/R2LiveImageStore.js"
    },
    "./R2Store": {
      "types": "./dist/R2Store.d.ts",
      "import": "./dist/R2Store.js"
    },
    "./R2S3Transport": {
      "types": "./dist/R2S3Transport.d.ts",
      "import": "./dist/R2S3Transport.js"
    },
    "./PgLiveImageStore": {
      "types": "./dist/PgLiveImageStore.d.ts",
      "import": "./dist/PgLiveImageStore.js"
    },
    "./D1LiveImageStore": {
      "types": "./dist/D1LiveImageStore.d.ts",
      "import": "./dist/D1LiveImageStore.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "README.md",
    "POWER_LOSS_TESTING.md",
    "LICENSE",
    "migrations/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist docs node_modules tsconfig.tsbuildinfo",
    "build": "tsc --project tsconfig.build.json && tsc --project compatibility/node-next/tsconfig.json",
    "test": "bun --bun run vitest run --config ../../vitest.config.ts --project persistence",
    "test:r2": "bun scripts/r2-smoke.ts",
    "test:r2:fault": "bun scripts/r2-fault-smoke.ts",
    "test:r2:volume": "bun scripts/r2-volume-smoke.ts",
    "type-check": "tsc --noEmit",
    "test:pg": "bun scripts/pg-test.ts",
    "test:d1": "bun scripts/d1-test.ts",
    "test:d1:remote": "wrangler dev --remote --config test/fixtures/d1.wrangler.jsonc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@effect-vfs/core": "^0.12.1"
  },
  "peerDependencies": {
    "@effect/sql-d1": "~4.1.5",
    "@effect/sql-pg": "~4.1.5",
    "effect": "~4.1.5"
  },
  "devDependencies": {
    "@effect/platform-node-shared": "4.1.5",
    "@effect/sql-d1": "4.1.5",
    "@effect/sql-pg": "4.1.5",
    "@effect/sql-sqlite-bun": "4.1.5",
    "@effect/vitest": "4.1.5",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "26.6.6",
    "effect": "4.1.5",
    "miniflare": "5.20261109.0-beta",
    "wrangler": "4.159.0"
  },
  "peerDependenciesMeta": {
    "@effect/sql-pg": {
      "optional": true
    },
    "@effect/sql-d1": {
      "optional": true
    }
  }
}
