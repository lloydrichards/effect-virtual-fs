{
  "name": "@effect-vfs/persistence",
  "version": "0.1.0",
  "description": "Named SQLite checkpoints for Effect virtual filesystems.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydrichards/effect-virtual-fs.git",
    "directory": "packages/persistence"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./CheckpointStore": { "types": "./dist/CheckpointStore.d.ts", "import": "./dist/CheckpointStore.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist/**", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc --project tsconfig.build.json && tsc --project compatibility/node-next/tsconfig.json",
    "test": "bun --bun run vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect-vfs/core": "^0.1.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "26.5.0",
    "effect": "4.0.0-rc.112"
  }
}
