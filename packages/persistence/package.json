{
  "name": "@effect-vfs/persistence",
  "version": "0.6.0",
  "description": "SQLite checkpoints and live-image storage for Effect virtual filesystems.",
  "homepage": "https://github.com/lloydrichards/effect-virtual-fs#readme",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydrichards/effect-virtual-fs.git",
    "directory": "packages/persistence"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./CheckpointStore": {
      "types": "./dist/CheckpointStore.d.ts",
      "import": "./dist/CheckpointStore.js"
    },
    "./SqliteLiveImageStore": {
      "types": "./dist/SqliteLiveImageStore.d.ts",
      "import": "./dist/SqliteLiveImageStore.js"
    },
    "./R2LiveImageStore": {
      "types": "./dist/R2LiveImageStore.d.ts",
      "import": "./dist/R2LiveImageStore.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/**", "README.md", "POWER_LOSS_TESTING.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist docs node_modules tsconfig.tsbuildinfo",
    "build": "tsc --project tsconfig.build.json && tsc --project compatibility/node-next/tsconfig.json",
    "test": "bun --bun run vitest run",
    "test:r2": "bun scripts/r2-smoke.ts",
    "test:r2:fault": "bun scripts/r2-fault-smoke.ts",
    "test:r2:volume": "bun scripts/r2-volume-smoke.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@effect-vfs/core": "^0.6.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/platform-node-shared": "4.0.0-rc.117",
    "@effect/sql-sqlite-bun": "4.0.0-rc.117",
    "@effect/vitest": "4.0.0-rc.117",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "26.6.3",
    "effect": "4.0.0-rc.117"
  }
}
