{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "display": "Default",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "lib": [
      "ES2023"
    ],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "barrelImportPackages": [
          "effect"
        ],
        "includeSuggestionsInTsc": false,
        "diagnostics": false,
        "effectFn": [
          "untraced"
        ],
        "diagnosticSeverity": {
          "effectFnOpportunity": "error",
          "lazyEffect": "error",
          "allOfMapToForEach": "error",
          "unsafeEffectTypeAssertion": "error",
          "anyUnknownInErrorContext": "error",
          "effectTryWithoutCatch": "error",
          "preferEffectArray": "off",
          "preferEffectRecord": "off",
          "preferEffectString": "off",
          "globalJson": "off",
          "schemaClassMissingBrand": "off",
          "errorPayloadShadowsName": "off",
          "resultMatchToFromResult": "off",
          "unstableApiUsage": "off",
          "strictEffectProvide": "off"
        },
        "overrides": [
          {
            "include": [
              "../../packages/core/src/internal/runtime.ts",
              "../../packages/core/src/internal/synchronous.ts",
              "../../packages/core/src/internal/durableStorage.ts",
              "../../packages/core/src/internal/volumeWatch.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "experimentalApiUsage": "off"
              }
            }
          },
          {
            "include": [
              "../../packages/core/src/internal/synchronous.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "runEffectInsideEffect": "off"
              }
            }
          }
        ]
      }
    ],
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage"
  ]
}
