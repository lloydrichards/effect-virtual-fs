{
  "name": "@repo/nfs-preview",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist docs node_modules tsconfig.tsbuildinfo",
    "build": "tsc --noEmit",
    "start": "bun run src/main.ts",
    "conformance": "bun run src/conformance.ts",
    "linux-mount-gate": "bash scripts/linux-mount-gate.sh",
    "verify-mount": "bash scripts/verify-mount.sh",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect-vfs/core": "workspace:*",
    "@effect-vfs/nfs": "workspace:*",
    "@effect/platform-bun": "4.0.0-rc.114",
    "effect": "4.0.0-rc.114"
  },
  "devDependencies": {
    "@repo/config-typescript": "workspace:*",
    "@types/bun": "^1.2.17"
  }
}
