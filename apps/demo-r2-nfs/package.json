{
  "name": "@repo/nfs-r2-writable-test",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "bun --env-file=.env src/main.ts",
    "dev:container": "wrangler dev --config wrangler.jsonc",
    "deploy:container": "wrangler deploy --config wrangler.jsonc",
    "type-check": "tsc --noEmit",
    "verify-mount": "bash scripts/verify-mount.sh"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@aws-sdk/client-s3": "3.1164.0",
    "@effect-vfs/core": "workspace:*",
    "@effect-vfs/nfs": "workspace:*",
    "@effect-vfs/persistence": "workspace:*",
    "@effect/platform-bun": "4.1.4",
    "@effect/platform-node-shared": "4.1.4",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@repo/config-typescript": "workspace:*",
    "@types/bun": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261109.1",
    "wrangler": "4.159.0"
  }
}
