{
  "name": "@effect-vfs/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "git clean -xdf build node_modules .react-router",
    "dev": "react-router dev",
    "docs:check": "bun run docs:generate && prettier --write \"app/content/api/**/*.mdx\" && bun run scripts/check-docs.ts",
    "docs:generate": "bun run scripts/generate-api-docs.ts",
    "prebuild": "bun run docs:check",
    "predev": "bun run docs:check",
    "type-check": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect-vfs/core": "workspace:*",
    "@effect-vfs/memory": "workspace:*",
    "@effect-vfs/persistence": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@react-router/node": "7.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^0.544.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "7.9.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "7.9.1",
    "@shikijs/transformers": "^3.12.2",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.2.22",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "3.8.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.12.2",
    "tailwindcss": "^4.1.13",
    "typescript": "7.0.2",
    "vite": "^7.1.7"
  }
}
