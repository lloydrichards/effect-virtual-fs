{
  "name": "@effect-vfs/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "git clean -xdf .cache .turbo build docs node_modules .react-router tsconfig.tsbuildinfo",
    "dev": "react-router dev",
    "docs:check": "bun run docs:generate && bun run scripts/check-docs.ts && bun run scripts/check-examples.ts",
    "docs:generate": "bun run scripts/generate-api-docs.ts",
    "prebuild": "bun run docs:check",
    "predev": "bun run docs:check",
    "type-check": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect-vfs/core": "workspace:*",
    "@effect-vfs/memory": "workspace:*",
    "@effect-vfs/persistence": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@react-router/node": "8.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^1.47.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "8.4.0",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.3.8",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "8.4.0",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.2.22",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "3.9.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.13",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  }
}
